# Configuration for the whole stack. Do not edit this file with real values: run
#
#     python3 scripts/gen_secrets.py
#
# which copies it to .env (gitignored) and fills in every value marked "generated".
# The only values you have to type yourself are the two model API keys.

# --- Models (LiteLLM "provider/model" strings) ---
LIGHTHOUSE_MODEL=anthropic/claude-sonnet-5-5
LIGHTHOUSE_DISTILL_MODEL=anthropic/claude-haiku-5-5
LIGHTHOUSE_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Network ---
# Address the published ports bind to. 127.0.0.1 keeps everything private to this machine;
# use 0.0.0.0 (or a LAN address) on a server that other devices should reach.
BIND_ADDRESS=127.0.0.1
# URLs as the browser sees them. They are baked into the web build, so rebuild after changing
# them: docker compose build web
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://localhost:8000
# The other two are plain container settings; `docker compose up -d` is enough after a change.
SITE_URL=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3100
# Origins allowed to call the API, as a JSON list. Defaults to the local web app.
# CORS_ORIGINS='["http://localhost:3000"]'

# --- Database and auth (self-hosted Supabase) ---
# Password of the Postgres roles (postgres, authenticator, supabase_auth_admin). Generated.
POSTGRES_PASSWORD=
# Secret that Supabase Auth signs access tokens with; the API verifies them with it. Generated.
JWT_SECRET=
# API keys for the Supabase gateway: JWTs signed with JWT_SECRET for the Postgres roles
# `anon` (public, shipped to the browser) and `service_role` (admin, bypasses RLS). Generated.
ANON_KEY=
SERVICE_ROLE_KEY=
# Copy of ANON_KEY for the web app (Vite only exposes variables that start with VITE_). Generated.
VITE_SUPABASE_ANON_KEY=
# Login for Supabase Studio (http://localhost:3001). Password generated.
DASHBOARD_USERNAME=lighthouse
DASHBOARD_PASSWORD=
# Encrypts the connection strings Studio sends to postgres-meta. Generated.
PG_META_CRYPTO_KEY=
# Set to true once your account exists, so nobody else can sign up.
DISABLE_SIGNUP=false
# Used when the backend runs on the host (uvicorn, pytest helpers). Inside docker compose it is
# replaced by the address of the `db` service. Generated from POSTGRES_PASSWORD.
DATABASE_URL=

# --- Tracing (self-hosted Langfuse; tracing is off when the two keys are empty) ---
# Key pair of the Langfuse project. Langfuse creates the project with these keys on first
# start and the backend sends traces with them. Generated.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where the backend finds Langfuse when it runs on the host. Replaced inside docker compose.
LANGFUSE_HOST=http://localhost:3100
# Login for the Langfuse UI (http://localhost:3100). Password generated.
LANGFUSE_INIT_USER_EMAIL=admin@lighthouse.local
LANGFUSE_INIT_USER_PASSWORD=
# Internal secrets of the Langfuse containers. All generated.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=

# --- Optional tuning (the values shown are the defaults built into the compose files) ---
# Lifetime of an access token in seconds.
# JWT_EXPIRY=3600
# Heap limit, in megabytes, of the Langfuse web and worker processes.
# LANGFUSE_NODE_HEAP_MB=768

# --- Not used yet: iCloud calendar ---
APPLE_ID=
APPLE_APP_PASSWORD=
