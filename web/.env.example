# Copy to .env.local for local development. Vite only exposes variables that
# start with VITE_, and everything here ends up in the public bundle, so never
# put a secret in this file.

# Base URL of the Lighthouse API.
VITE_API_URL=http://localhost:8080

# Supabase is used for sign in and sign up only.
VITE_SUPABASE_URL=http://localhost:8000

# The anon key is public by design. Never use the service role key here.
VITE_SUPABASE_ANON_KEY=

# Set to 1 to run without a backend: an in-memory fake of the API and of auth
# (see src/mock). `pnpm dev:mock` sets it for you.
# VITE_MOCK=1
