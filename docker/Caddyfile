# Serves the built web app (see web.Dockerfile). Plain HTTP on port 80 inside the container;
# put a TLS-terminating proxy in front if this is ever exposed beyond the local network.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# The first `handle` block whose matcher fits answers the request.

	# Vite puts a content hash in every file name under /assets, so an existing file never
	# changes and can be cached forever.
	@asset {
		path /assets/*
		file
	}
	handle @asset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# An asset that does not exist is an error (usually a tab still running an older build),
	# not a page: answer 404 instead of falling through to index.html.
	handle /assets/* {
		respond 404
	}

	# Single-page app: any other path that is not a file (e.g. /notes/123) is a client-side
	# route, so answer it with index.html. It must be revalidated on every load, or browsers
	# would keep running an old build.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
